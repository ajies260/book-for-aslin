# MySQL server. Create ajiesbooks first (utf8mb4).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=books_app
DB_PASSWORD=CHANGE_ME
DB_NAME=ajiesbooks
DATABASE_URL=mysql://books_app:CHANGE_ME@127.0.0.1:3306/ajiesbooks

# Required secrets; generate with: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173
PORT=4000
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000/api

# Seed administrator and up to four approved members. Use strong unique passwords.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN
MEMBER1_EMAIL=aslin@example.com
MEMBER1_PASSWORD=CHANGE_ME_MEMBER
MEMBER2_EMAIL=
MEMBER2_PASSWORD=
MEMBER3_EMAIL=
MEMBER3_PASSWORD=
MEMBER4_EMAIL=
MEMBER4_PASSWORD=

# Optional server-side provider settings
GOOGLE_BOOKS_API_KEY=
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
